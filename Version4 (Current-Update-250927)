# This file contains pin mappings for the stock 2020 Creality Ender 3
# V2. REPROGRAMMED FOR ENDER 3 NEO To use this config, during "make menuconfig" select the
# STM32F103 with a "28KiB bootloader" and serial (on USART1 PA10/PA9)
# communication.

# If you prefer a direct serial connection, in "make menuconfig"
# select "Enable extra low-level configuration options" and select
# serial (on USART3 PB11/PB10), which is broken out on the 10 pin IDC
# cable used for the LCD module as follows:
# 3: Tx, 4: Rx, 9: GND, 10: VCC

# Flash this firmware by copying "out/klipper.bin" to a SD card and
# turning on the printer with the card inserted. The firmware
# filename must end in ".bin" and must not match the last filename
# that was flashed.

# See docs/Config_Reference.md for a description of parameters.
[include mainsail.cfg]
[exclude_object]


[delayed_gcode shutdown_machine]
gcode:
     {action_call_remote_method("shutdown_machine")}
initial_duration: 0.0

[menu __main __shutdown]
type: list
name: Shutdown Menu
enable: true

[menu __main __shutdown __poweroff]
type: command
enable: {printer.idle_timeout.state != "Printing"}
name: Shutdown !
gcode:
     M117 shutting down !
     #M118 shutting down !
     { menu.exit() }    
     UPDATE_DELAYED_GCODE ID=shutdown_machine DURATION=1

[stepper_x]
step_pin: PC2
dir_pin: PB9
enable_pin: !PC3
microsteps: 16
rotation_distance: 40.7554 #40.2246
endstop_pin: ^PA5
position_endstop: -21
position_min: -21
position_max: 242
homing_speed: 60
homing_retract_dist: 3
homing_retract_speed: 25

[stepper_y]
step_pin: PB8
dir_pin: PB7
enable_pin: !PC3
microsteps: 16
rotation_distance: 40.6214 #40.2192
endstop_pin: ^PA6
position_endstop: -7
position_min: -7
position_max: 242
homing_speed: 60
homing_retract_dist: 3
homing_retract_speed: 25

[stepper_z]
step_pin: PB6
dir_pin: !PB5
enable_pin: !PC3
microsteps: 16
rotation_distance: 7.952 #8
endstop_pin: probe:z_virtual_endstop
position_max: 255
position_min: -10
homing_speed: 20
second_homing_speed: 5
homing_retract_dist: 2.0

[extruder]
max_extrude_only_distance: 1000
#max_extrude_cross_section: 0.64
step_pin: PB4
dir_pin: PB3
enable_pin: !PC3
microsteps: 16
rotation_distance: 30.2323 #31.8235 #32.473 # e-steps was 34.406 but 32.473 in creality sonic pad config
nozzle_diameter: 0.400
filament_diameter: 1.750
heater_pin: PA1
sensor_type: EPCOS 100K B57560G104F
sensor_pin: PC5
control: pid
#pressure_advance = 1.0
# tuned @ 200C 12.02.2023
pid_kp = 24.974
pid_ki = 1.435
pid_kd = 108.636
min_temp: 0
max_temp: 265

[heater_bed]
heater_pin: PA2
sensor_type: EPCOS 100K B57560G104F
sensor_pin: PC4
control: pid
# tuned for stock hardware with 50 degree Celsius target
pid_Kp: 54.027
pid_Ki: 0.770
pid_Kd: 948.182
min_temp: 0
max_temp: 130

[fan]
pin: PA0

[mcu]
serial: /dev/serial/by-id/usb-1a86_USB_Serial-if00-port0
restart_method: command

[mcu CB1]
serial: /tmp/klipper_host_mcu

[printer]
kinematics: cartesian
max_velocity: 300
max_accel: 3000
max_z_velocity: 20
max_z_accel: 100

[virtual_sdcard]
path: ~/printer_data/gcodes

[pause_resume]

[bltouch]
sensor_pin: ^PB1
control_pin: PB0 
x_offset: -39.5
y_offset: -10
#z_offset: 3

[safe_z_home]
home_xy_position: 157, 117.5 # Change coordinates to the center of your print bed
speed: 240
z_hop: 20                 # Move up 10mm
z_hop_speed: 20

[display]
lcd_type: st7920
cs_pin: PB12
sclk_pin: PB13
sid_pin: PB15
encoder_pins: ^PB14, ^PB10
click_pin: ^!PB2

[bed_mesh]
speed: 240
horizontal_move_z: 5
mesh_min: 37, 15
mesh_max: 198, 211
probe_count: 3,3
algorithm: bicubic
fade_start: 1
fade_end: 10
fade_target: 0

[screws_tilt_adjust]
screw1: 77,37.5
screw1_name: front left screw
screw2: 240,37.5
screw2_name: front right screw
screw3: 240,217.5
screw3_name: rear right screw
screw4: 77,217.5
screw4_name: rear left screw
horizontal_move_z: 10
speed: 80
screw_thread: CW-M4

[respond]
default_type: command
[pause_resume] recover_velocity: 50

[gcode_macro G29]
gcode:
    BED_MESH_CLEAR
    BED_MESH_CALIBRATE
    BED_MESH_PROFILE SAVE=default
    BED_MESH_PROFILE LOAD=default

[gcode_macro print_start]
gcode:
  ; Ender 3 Custom Start G-code
  M82
  G92 E0 ; Reset Extruder
  G28 ; Home all axes
  G29 ; Auto Bed Leveling
  G1 Z2.0 F3000 ; Move Z Axis up little to prevent scratching of Heat Bed

  G92 E0 ; reset extruder distance position
  G1 X10 Y3 Z0.3 F5000.0 ; go outside print area
  G1 X110 E15 F1000.0 ; intro line
  G1 X210 E30 Z0.4 F1000.0 ; intro line
  G92 E0 ; Reset Extruder
  G1 Z2.0 F3000 ; Move Z Axis up little to prevent scratching of Heat Bed
  M83

[gcode_macro print_end]
gcode:
  G91 ;Relative positioning
  G1 E-2 F2700 ;Retract a bit
  G1 E-1 Z0.2 F2400 ;Retract and raise Z
  G1 X5 Y5 F3000 ;Wipe out
  G1 Z10 ;Raise Z more
  G90 ;Absolute positioning
  G1 X3 Y200 ;Present print
  M106 S0 ;Turn-off fan
  M104 S0 ;Turn-off hotend
  M140 S0 ;Turn-off bed
  M84 X Y E ;Disable all steppers but Z

[gcode_macro UNLOAD_FILAMENT]
gcode:
  SAVE_GCODE_STATE NAME=unload_state
  G91
  {% if params.TEMP is defined or printer.extruder.can_extrude|lower == 'false' %}
    M117 Heating...
    # Heat up hotend to provided temp or 220 as default as that should work OK with most filaments.
    M109 S{params.TEMP|default(220, true)}
  {% endif %}
  M117 Unloading filament...
  G92 E0.0
  G91
  G1 E10 F250
  #G1 E-480 F2000
  G1 E-50  F1000
  G1 E-400 F10000
  G90
  G92 E0.0
  M400
  M117 Remove Filament Now!
  M300 S300 P1000
  M117 Filament unloaded!
  RESTORE_GCODE_STATE NAME=unload_state

[gcode_macro LOAD_FILAMENT]
gcode:
  SAVE_GCODE_STATE NAME=load_state
  G91
  # Heat up hotend to provided temp or 220 as default as that should work OK with most filaments.
  {% if params.TEMP is defined or printer.extruder.can_extrude|lower == 'false' %}
  M117 Heating...
  M109 S{params.TEMP|default(220, true)}
  {% endif %}
  M117 Loading filament...
  # Load the filament into the hotend area.
  G92 E0.0
  G91
  G1 E300 F10000
  G1 E100 F250
  G1 E-5 F500
  G90
  G92 E0.0
  M400
  M117 Filament loaded!
  RESTORE_GCODE_STATE NAME=load_state

[gcode_macro Bed_Screw_Calibration]
gcode:
  SET_HEATER_TEMPERATURE HEATER=heater_bed TARGET=55
  G28
  SCREWS_TILT_CALCULATE
  SET_HEATER_TEMPERATURE HEATER=heater_bed TARGET=0

